# The main domain everything hangs off. No https://, no www.
ROOT_DOMAIN=pykk.uk

# Hostname serving the public pages (client pay pages, page-view beacon, public API).
# If your host cannot attach a second domain to the Node app, set this to admin.pykk.uk —
# /pay/..., /api/pv and /healthz keep working on the admin host.
PUBLIC_APP_HOST=app.pykk.uk

# MySQL connection from cPanel (cPanel adds a prefix, e.g. cpaneluser_pykk).
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME

# Optional: email sending (fallback for the daily summary). Empty = off.
EMAIL_API_KEY=
EMAIL_FROM=

# Random 64-character hex string that signs admin sessions. Generate: openssl rand -hex 32
SESSION_SECRET=

# Random 64-character hex string the daily cron job must send as a header. Generate: openssl rand -hex 32
CRON_SECRET=

# Default monthly price for a client site, in pence (499 = £4.99).
DEFAULT_PRICE_PENCE=499

# Comma-separated IPs allowed into the admin panel. Empty = allow all.
# Never blocks /pay/*, /api/pv or /healthz.
ADMIN_IP_ALLOWLIST=

# Where the client sites live on the server (used to show "site exists" in the admin panel).
SITES_DIR=/home/CPANELUSER/pykk/sites

# Optional: Telegram notifications about payments and new clients. Empty = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Stripe webhook secret (used later for online card payments). Empty = off.
STRIPE_WEBHOOK_SECRET=
